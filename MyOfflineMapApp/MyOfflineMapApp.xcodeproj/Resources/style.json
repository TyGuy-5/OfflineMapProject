{
  "version": 8,
  "name": "MyOfflineMapApp Outdoor Trails Style",
  "metadata": {
    "maputnik:renderer": "mbgljs"
  },
  "center": [-122.4194, 37.7749],
  "zoom": 12,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "https://tile.openstreetmap.org/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#EBF2E8"
      }
    },
    {
      "id": "landuse-natural",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#DDEFD8",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#CDE8C7",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#A5BFDD"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#A5BFDD",
        "line-width": 1.5
      }
    },
    {
      "id": "tunnel",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "brunnel", "tunnel"],
      "paint": {
        "line-color": "#B8B8B8",
        "line-dasharray": [1.5, 0.75],
        "line-width": 2
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!in", "class", "path", "track"],
        ["!=", "brunnel", "tunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D0D0D0",
        "line-width": {
          "base": 1.2,
          "stops": [[10, 1.5], [14, 4.0], [18, 12.0]]
        }
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!in", "class", "path", "track"],
        ["!=", "brunnel", "tunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "base": 1.2,
          "stops": [[10, 1.0], [14, 3.0], [18, 10.0]]
        }
      }
    },
    {
      "id": "highway-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFAA44",
        "line-width": {
          "base": 1.2,
          "stops": [[8, 1.5], [12, 4.0], [16, 10.0]]
        }
      }
    },
    {
      "id": "osm-high-contrast-trails-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["in", "class", "path", "track"],
        ["!in", "subclass", "steps"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#1A1A1A",
        "line-opacity": 0.5,
        "line-width": {
          "base": 1.2,
          "stops": [[11, 2.2], [13, 3.5], [15, 5.0], [17, 7.0]]
        }
      }
    },
    {
      "id": "osm-high-contrast-trails",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["in", "class", "path", "track"],
        ["!in", "subclass", "steps"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FC4C02",
        "line-dasharray": [2, 2],
        "line-width": {
          "base": 1.2,
          "stops": [[11, 1.2], [13, 2.2], [15, 3.5], [17, 5.0]]
        },
        "line-opacity": 0.95
      }
    },
    {
      "id": "place-neighborhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "neighbourhood"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Open Sans Regular"],
        "text-size": 12,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#4A4A4A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Open Sans Bold"],
        "text-size": {
          "stops": [[6, 12], [12, 18]]
        }
      },
      "paint": {
        "text-color": "#202020",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2.0
      }
    },
    {
      "id": "trail-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["in", "class", "path", "track"],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Open Sans Italic"],
        "text-size": 11,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#B83200",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    }
  ]
}
